/var/lib/mysql/mysql-slow.log /var/lib/mysql/mysql-error.log {
	daily
	rotate 30
	missingok
	notifempty
	maxsize 100M
	create 640 mysql adm
	compress
	delaycompress
	sharedscripts
	postrotate
          test -x /usr/bin/mysqladmin || exit 0
          if mysqladmin ping > /dev/null 2>&1; then
            mysqladmin --local flush-error-log flush-slow-log
          fi
	endscript
}